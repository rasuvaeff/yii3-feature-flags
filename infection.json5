{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // 4 equivalent mutants — no ignores.
    // - PercentageRollout::isEnabled 0% / 100% guards (Decrement, Increment,
    //   2×ReturnRemoval): hash path at boundaries yields always-false / always-true,
    //   producing identical results to the early return (bucket is always 0..99).
    "minMsi": 95,
    "mutators": {
        "@default": true
    }
}
